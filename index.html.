
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DocAlert - Smart Document Reminder</title>

<style>
*{box-sizing:border-box}
body{margin:0;padding:18px;background:#f2f5fb;color:#26334d;font-family:Arial,sans-serif}
.container{max-width:760px;margin:auto}
header{background:linear-gradient(135deg,#244cbd,#4779e8);color:white;padding:25px;border-radius:18px;margin-bottom:18px}
header h1{margin:0 0 8px;font-size:29px}
header p{margin:0;font-size:14px}
.card{background:white;padding:20px;border-radius:15px;margin-bottom:18px;box-shadow:0 3px 12px #00000008}
h2{font-size:19px;margin-top:0}
input,select{width:100%;padding:13px;margin:7px 0 14px;border:1px solid #dce2ed;border-radius:9px;font-size:15px;background:white}
label{font-size:13px;font-weight:bold}
button{border:0;border-radius:9px;padding:12px 17px;background:#244cbd;color:white;font-size:14px;margin:4px;cursor:pointer}
button:disabled{opacity:.5}
.secondary{background:#e9efff;color:#244cbd}
.danger{background:#fff0f0;color:#c22d2d}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}
.stat{background:white;padding:15px 5px;text-align:center;border-radius:12px}
.stat strong{display:block;font-size:25px;color:#244cbd}
.stat span{font-size:11px;color:#667085}
.document{border:1px solid #e6ebf3;padding:15px;border-radius:12px;margin:12px 0}
.document h3{margin:0 0 8px;font-size:16px}
.info{font-size:13px;color:#667085;line-height:1.8}
.status{display:inline-block;padding:6px 10px;border-radius:20px;font-size:11px;margin:8px 0}
.green{background:#e4f8ec;color:#168344}
.yellow{background:#fff3d6;color:#a36a00}
.red{background:#ffe5e5;color:#c22d2d}
.hidden{display:none}
.message{font-size:13px;margin:10px 0;color:#244cbd;overflow-wrap:anywhere}
.alert-card{background:#fff8e8;padding:14px;border-radius:10px;margin-bottom:10px;font-size:13px;color:#805500}
footer{text-align:center;color:#8993a5;font-size:12px;padding:15px}
@media(max-width:400px){body{padding:10px}.card{padding:15px}}
</style>
</head>

<body>
<div class="container">

<header>
<h1>📁 DocAlert</h1>
<p>Your documents. Your reminders. Never miss a renewal.</p>
</header>

<div class="card" id="authBox">
<h2>Welcome to DocAlert 👋</h2>
<p>Create an account or log in to access your documents on both devices.</p>
<label>Email Address</label>
<input id="email" type="email" placeholder="Enter your email">
<label>Password</label>
<input id="password" type="password" placeholder="At least 6 characters">
<button onclick="login()">Login</button>
<button class="secondary" onclick="register()">Create Account</button>
<p id="authMessage" class="message"></p>
</div>

<div id="app" class="hidden">

<div class="card">
<strong>My Account</strong>
<div id="userEmail" class="info"></div>
<p id="syncMessage" class="message">Connecting to cloud...</p>
<button class="danger" onclick="logout()">Logout</button>
</div>

<div class="stats">
<div class="stat"><strong id="total">0</strong><span>Total Documents</span></div>
<div class="stat"><strong id="upcoming">0</strong><span>Expiring Soon</span></div>
<div class="stat"><strong id="expired">0</strong><span>Expired</span></div>
</div>

<div class="card">
<h2>🔔 Renewal Priority Alerts</h2>
<div id="alerts"></div>
</div>

<div class="card">
<h2>➕ Add New Document</h2>
<label>Document Name</label>
<input id="docName" placeholder="e.g. Driving Licence">
<label>Category</label>
<select id="category">
<option>Identity Document</option>
<option>Education Certificate</option>
<option>Vehicle Document</option>
<option>Insurance</option>
<option>Other</option>
</select>
<label>Expiry Date</label>
<input id="expiryDate" type="date">
<button id="saveBtn" onclick="saveDocument()">Save Document</button>
<button id="cancelBtn" class="secondary hidden" onclick="cancelEdit()">Cancel Edit</button>
</div>

<div class="card">
<h2>📋 My Documents</h2>
<input id="search" placeholder="Search documents..." oninput="render()">
<div id="documentList">Loading documents...</div>
</div>

</div>

<footer>DocAlert © 2026 | Stay Updated, Stay Prepared ❤️</footer>
</div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<script>
const firebaseConfig = {
  apiKey: "AIzaSyC_T_TVw3tCe7aw6PRrLs9BcCN19wnGQGQ",
  authDomain: "docalert-23f6f.firebaseapp.com",
  projectId: "docalert-23f6f",
  storageBucket: "docalert-23f6f.firebasestorage.app",
  messagingSenderId: "336137339131",
  appId: "1:336137339131:web:94595ef2716f5eb117705e",
  measurementId: "G-LSBG5NDQ5P"
};

firebase.initializeApp(firebaseConfig);

const auth=firebase.auth();
const db=firebase.firestore();

let currentUser=null;
let documents=[];
let unsubscribe=null;
let editingId=null;

function showMessage(id,text){
 document.getElementById(id).textContent=text;
}

function register(){
 const email=document.getElementById("email").value.trim();
 const password=document.getElementById("password").value;

 if(!email||password.length<6){
  showMessage("authMessage","Enter a valid email and password of at least 6 characters.");
  return;
 }

 showMessage("authMessage","Creating account...");

 auth.createUserWithEmailAndPassword(email,password)
 .catch(e=>showMessage("authMessage",e.message));
}

function login(){
 const email=document.getElementById("email").value.trim();
 const password=document.getElementById("password").value;

 if(!email||!password){
  showMessage("authMessage","Please enter email and password.");
  return;
 }

 showMessage("authMessage","Logging in...");

 auth.signInWithEmailAndPassword(email,password)
 .catch(e=>showMessage("authMessage",e.message));
}

function logout(){
 auth.signOut();
}

auth.onAuthStateChanged(user=>{
 if(user){
  currentUser=user;
  document.getElementById("authBox").classList.add("hidden");
  document.getElementById("app").classList.remove("hidden");
  document.getElementById("userEmail").textContent=user.email;
  loadDocuments();
 }else{
  if(unsubscribe){unsubscribe();unsubscribe=null;}
  currentUser=null;
  documents=[];
  document.getElementById("app").classList.add("hidden");
  document.getElementById("authBox").classList.remove("hidden");
  document.getElementById("password").value="";
 }
});

function loadDocuments(){
 if(unsubscribe)unsubscribe();

 showMessage("syncMessage","Connecting to Firebase...");

 unsubscribe=db.collection("users")
 .doc(currentUser.uid)
 .collection("documents")
 .onSnapshot(snapshot=>{
  documents=snapshot.docs.map(doc=>({id:doc.id,...doc.data()}));
  showMessage("syncMessage","☁ Cloud sync is active");
  render();
 },error=>{
  showMessage("syncMessage","Sync error: "+error.message);
 });
}

function getStatus(date){
 const today=new Date();
 today.setHours(0,0,0,0);

 const expiry=new Date(date+"T00:00:00");
 const days=Math.round((expiry-today)/86400000);

 if(days<0)return {text:"Renewal Required",css:"red",days:days};
 if(days===0)return {text:"Expires Today - Urgent!",css:"red",days:days};
 if(days===1)return {text:"Urgent - 1 Day Left",css:"red",days:days};
 if(days<=7)return {text:"Important - 7 Days Left",css:"yellow",days:days};
 if(days<=30)return {text:"Plan Renewal - 30 Days Left",css:"yellow",days:days};

 return {text:"Valid",css:"green",days:days};
}

async function saveDocument(){
 if(!currentUser)return;

 const name=document.getElementById("docName").value.trim();
 const category=document.getElementById("category").value;
 const date=document.getElementById("expiryDate").value;

 if(!name||!date){
  alert("Please enter document name and expiry date.");
  return;
 }

 const button=document.getElementById("saveBtn");
 button.disabled=true;

 try{
  const collection=db.collection("users")
  .doc(currentUser.uid).collection("documents");

  const data={name:name,category:category,date:date};

  if(editingId){
   await collection.doc(editingId).update(data);
  }else{
   await collection.add(data);
  }

  cancelEdit();
  alert("Document saved successfully!");
 }catch(e){
  alert("Save failed: "+e.message);
 }finally{
  button.disabled=false;
 }
}

function editDocument(id){
 const doc=documents.find(d=>d.id===id);
 if(!doc)return;

 editingId=id;
 document.getElementById("docName").value=doc.name;
 document.getElementById("category").value=doc.category;
 document.getElementById("expiryDate").value=doc.date;
 document.getElementById("saveBtn").textContent="Update Document";
 document.getElementById("cancelBtn").classList.remove("hidden");
 window.scrollTo({top:0,behavior:"smooth"});
}

function cancelEdit(){
 editingId=null;
 document.getElementById("docName").value="";
 document.getElementById("expiryDate").value="";
 document.getElementById("saveBtn").textContent="Save Document";
 document.getElementById("cancelBtn").classList.add("hidden");
}

async function deleteDocument(id){
 if(!confirm("Are you sure you want to delete this document?"))return;

 try{
  await db.collection("users")
  .doc(currentUser.uid).collection("documents")
  .doc(id).delete();
 }catch(e){
  alert("Delete failed: "+e.message);
 }
}

function escapeHTML(value){
 return String(value).replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",
  '"':"&quot;","'":"&#39;"
 }[c]));
}

function render(){
 const search=document.getElementById("search").value.toLowerCase();

 let soon=0,expired=0;
 documents.forEach(doc=>{
  const s=getStatus(doc.date);
  if(s.days>=0&&s.days<=30)soon++;
  if(s.days<0)expired++;
 });

 document.getElementById("total").textContent=documents.length;
 document.getElementById("upcoming").textContent=soon;
 document.getElementById("expired").textContent=expired;

 const alertList=document.getElementById("alerts");
 const priority=documents.filter(doc=>getStatus(doc.date).days<=30)
 .sort((a,b)=>a.date.localeCompare(b.date));

 if(priority.length===0){
  alertList.innerHTML="<p>No upcoming renewals. You're all caught up! 🎉</p>";
 }else{
  alertList.innerHTML=priority.map(doc=>{
   const s=getStatus(doc.date);
   return `<div class="alert-card">
   <strong>${escapeHTML(doc.name)}</strong><br>
   ${escapeHTML(s.text)}<br>
   Expiry: ${escapeHTML(doc.date)}
   </div>`;
  }).join("");
 }

 const filtered=documents.filter(doc=>
  doc.name.toLowerCase().includes(search)||
  doc.category.toLowerCase().includes(search)
 );

 const list=document.getElementById("documentList");

 if(filtered.length===0){
  list.textContent="No documents found. Add your first document!";
  return;
 }

 list.innerHTML=filtered.map(doc=>{
  const s=getStatus(doc.date);
  return `<div class="document">
   <h3>📄 ${escapeHTML(doc.name)}</h3>
   <div class="info">
   Category: ${escapeHTML(doc.category)}<br>
   Expiry Date: ${escapeHTML(doc.date)}
   </div>
   <span class="status ${s.css}">${escapeHTML(s.text)}</span><br>
   <button class="secondary" onclick="editDocument('${doc.id}')">Edit</button>
   <button class="danger" onclick="deleteDocument('${doc.id}')">Delete</button>
  </div>`;
 }).join("");
}
</script>
</body>
</html>

